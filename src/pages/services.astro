---
import TitleAndText from '../ui/TitleAndText.astro';
import { data } from '../data/data';

const { services } = data;
---

<section class="flex flex-col">
  <TitleAndText title="Servicios" />
  <div class="flex flex-col gap-8 md:ml-4">
    {
      services.map((service) => (
        <div class="flex flex-col md:flex-row gap-4 md:items-center">
          <h3 class="font-semibold text-secondary md:w-64">{service.name}</h3>
          <div class="flex flex-wrap gap-2">
            {service.service.map((dataService) => (
              <span class="service-chip text-center border border-muted text-primary text-sm px-3 py-1.5 rounded-full bg-background/50 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:shadow-md">
                {dataService}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  @keyframes slide-in-diagonal {
    0% {
      opacity: 0;
      transform: translateY(24px) translateX(-12px) scale(0.85);
    }
    40% {
      opacity: 0.6;
      transform: translateY(8px) translateX(-4px) scale(0.95);
    }
    70% {
      opacity: 0.9;
      transform: translateY(-2px) translateX(1px) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateY(0) translateX(0) scale(1);
    }
  }

  .service-chip:nth-child(1) {
    --delay: 0ms;
  }
  .service-chip:nth-child(2) {
    --delay: 80ms;
  }
  .service-chip:nth-child(3) {
    --delay: 160ms;
  }
  .service-chip:nth-child(4) {
    --delay: 240ms;
  }
  .service-chip:nth-child(5) {
    --delay: 700ms;
  }

  .service-chip {
    opacity: 0;
    animation: slide-in-diagonal 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--delay, 0ms);
  }
</style>
