---
import { Image } from 'astro:assets';
import StadisticCards from '../components/StadisticCards.astro';
import TitleAndText from '../ui/TitleAndText.astro';

import { data } from '../data/data';

const { about } = data;
---

<div class="flex flex-col gap-8">
  <TitleAndText title="Nosotros" description={about.description} />
  <section class="flex flex-col justify-between gap-8 sm:flex-row">
    <div class="grid grid-cols-2 grid-rows-2 gap-4 ml-8">
      <StadisticCards />
    </div>
    <div class="flex flex-col gap-8 sm:flex-row">
      <TitleAndText title={about.profile.name} description={about.profile.notes} />
      <Image
        class="object-center object-cover rounded-sm md:w-[440px] w-full md:h-[440px] h-[300px]"
        src={about.profile.src}
        loading="lazy"
        alt={about.profile.name}
        height="300"
        width="300"
      />
    </div>
  </section>
</div>
