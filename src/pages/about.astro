---
import { Image } from 'astro:assets';
import StadisticCards from '../components/StadisticCards.astro';
import TitleAndText from '../ui/TitleAndText.astro';

import { data } from '../data/data';

const { about } = data;
---

<div class="flex flex-col gap-8 text-primary">
  <TitleAndText title="Nosotros" description={about.description} margin="md:ml-4" />
  <section class="flex flex-col justify-between gap-8 sm:flex-row">
    <div class="grid grid-cols-2 grid-rows-2 gap-4 md:ml-4">
      <StadisticCards />
    </div>
    <div class="flex flex-col gap-8 sm:flex-row">
      <TitleAndText title={about.profile.name} description={about.profile.notes} />
      <!-- Contenedor fijo para el overflow -->
      <div class="w-full sm:w-[220px] md:w-[250px] lg:w-[440px] h-auto overflow-hidden rounded-sm">
        <div class="parallax-container-lateral w-full h-auto" data-parallax-speed="0.8">
          <Image
            src={about.profile.src}
            alt={about.profile.name}
            widths={[320, 400, 440, 960]}
            sizes="(max-width: 640px) 100vw, (max-width: 768px) 50vw, 250px, (max-width: 1024px) 440px"
            class="w-full h-auto object-cover rounded-sm"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const parallaxElements = document.querySelectorAll('.parallax-container-lateral');

    if (parallaxElements.length === 0) return;

    let ticking = false;

    // Función optimizada de parallax con throttling
    function updateParallax() {
      parallaxElements.forEach((element) => {
        const rect = element.getBoundingClientRect();
        const speed = parseFloat(element.dataset.parallaxSpeed) || 0.3;

        // Solo aplicar parallax si el elemento está cerca del viewport
        if (rect.bottom >= -100 && rect.top <= window.innerHeight + 100) {
          // Calculamos el progreso del scroll (0 cuando entra, 1 cuando sale)
          const progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);

          // Aplicamos el movimiento lateral basado en el progreso
          const movement = (progress - 0.5) * 100 * speed;

          element.style.transform = `translateX(${movement}px)`;
        }
      });

      ticking = false;
    }

    // Throttling del scroll para mejor rendimiento
    function handleScroll() {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    // Intersection Observer para optimizar rendimiento
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.addEventListener('scroll', handleScroll, { passive: true });
            // Ejecutar una vez al entrar en vista
            updateParallax();
          } else {
            window.removeEventListener('scroll', handleScroll);
          }
        });
      },
      {
        rootMargin: '50px 0px', // Margen para activar antes de que sea visible
        threshold: 0,
      }
    );

    // Observar cada elemento parallax
    parallaxElements.forEach((element) => {
      observer.observe(element);
    });

    // Cleanup al cambiar de página (importante en Astro)
    window.addEventListener('beforeunload', () => {
      observer.disconnect();
      window.removeEventListener('scroll', handleScroll);
    });
  });
</script>

<style>
  /* Estilos CSS para suavizar la transición */
  .parallax-container-lateral {
    transition: transform 0.1s ease-out;
    will-change: transform;
  }

  /* Reducir movimiento para usuarios que prefieren menos animaciones */
  @media (prefers-reduced-motion: reduce) {
    .parallax-container-lateral {
      transform: none !important;
    }
  }
</style>
