---
import ContactForm from '@/components/ContactForm.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../ui/Hero.astro';
import About from './about.astro';
import Projects from './projects.astro';
import Services from './services.astro';
import ContactIcon from '@/ui/ContactIcon.astro';
import TopographicBackground from '@/ui/TopographicBackground.astro';

const marginTopNavigation = 'scroll-mt-48';
---

<Layout
  title="Agrimensura DGA"
  description="Servicios de agrimensura en Argentina: mensuras, estados parcelarios, levantamientos topográficos, georreferenciación y subdivisiones."
>
  <main class="flex flex-col gap-mobile sm:gap-tablet md:gap-web">
    <TopographicBackground />
    <div id="init" class={marginTopNavigation}>
      <!--TODO: Decidir cual de los dos colocamos -->
      <Hero />
      <!-- <VideoHero /> -->
    </div>
    <div id="about" class={`${marginTopNavigation} about`}>
      <About />
    </div>
    <div id="services" class={`${marginTopNavigation} services`}>
      <Services />
    </div>
    <div id="projects" class={`${marginTopNavigation}`}>
      <Projects />
    </div>
    <div id="contact" class={`${marginTopNavigation}`}>
      <ContactForm />
    </div>
    <ContactIcon />
  </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/simple-parallax-js@5.6.2/dist/simpleParallax.min.js"
></script>

<style>
  .about {
    animation: revealX linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 30%;
  }

  .services {
    animation: revealY ease-in-out both;
    animation-timeline: scroll();
    animation-range: entry 11% cover 30%;
  }
</style>
