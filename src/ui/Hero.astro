---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/01.png';
---

<section
  id="parallax-wrapper"
  class="parallax-section rounded-xl sm:rounded-2xl lg:rounded-3xl"
  data-parallax
>
  <Image
    class="parallax-image w-full object-cover rounded"
    src={heroImage}
    widths={[320, 640, 768, 1024, 1280, 1536]}
    sizes="100vw"
    loading="eager"
    alt="Prueba"
    format="webp"
    quality={85}
  />

  <!-- //TODO: Ver si se agrega algo -->
  <!-- <div class="parallax-content font-geist text-7xl text-background">
    <h3>DGA</h3>
    <h2>AGRIMENSURA</h2>
  </div> -->
</section>

<script is:client>
  window.addEventListener('DOMContentLoaded', () => {
    const images = document.getElementsByClassName('parallax-image');
    if (images.length > 0 && window.simpleParallax) {
      new window.simpleParallax(images, {
        delay: 1,
        scale: 1.5,
        transition: 'cubic-bezier(0,0,0,1)',
        customWrapper: '#parallax-wrapper',
      });
    }
  });
</script>
