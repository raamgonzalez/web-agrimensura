---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/01.png';
---

<Image
  class="w-full aspect-[16/9] sm:aspect-[4/3] md:aspect-[3/2] lg:aspect-[16/9] rounded-xl sm:rounded-2xl lg:rounded-3xl object-cover"
  src={heroImage}
  widths={[320, 640, 768, 1024, 1280, 1536]}
  sizes="(max-width: 640px) 100vw, (max-width: 768px) 100vw, (max-width: 1024px) 100vw, 100vw"
  loading="eager"
  alt="Prueba"
  format="webp"
  quality={85}
/>
