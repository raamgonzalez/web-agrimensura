---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/01.png';
---

<section
  class="relative h-[600px] md:h-screen overflow-hidden rounded-xl sm:rounded-2xl lg:rounded-3xl"
>
  <div class="parallax-bg absolute inset-0 will-change-transform">
    <Image
      class="w-full h-[600px] md:h-[120%] object-cover scale-105 sm:scale-110 object-right"
      src={heroImage}
      widths={[320, 640, 768, 1024, 1280, 1536]}
      sizes="100vw"
      loading="eager"
      alt="Servicios de Agrimensura Profesional"
      format="webp"
      quality={85}
    />
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/20 to-black/40"></div>

  <!-- Contenido -->
  <div
    class="parallax-text relative z-10 h-full flex flex-col justify-center items-center text-center px-4"
  >
    <h1
      class="hero-title font-inter text-5xl md:text-7xl lg:text-8xl text-white font-bold tracking-wide opacity-0 animate-fade-in-up"
    >
      Servicios de agrimensura
    </h1>
    <p
      class="hidden md:block hero-subtitle text-white/90 text-xl md:text-2xl mt-6 max-w-2xl opacity-0 animate-fade-in-up animation-delay-200"
    >
      Profesionales especializados en medición y delimitación de terrenos
    </p>
    <button
      class="cursor-pointer hero-cta mt-8 bg-accent hover:bg-accent/90 rounded-md text-primary px-8 py-3 font-semibold text-lg transition-all duration-300 hover:scale-105 hover:shadow-xl opacity-0 animate-fade-in-up animation-delay-400"
    >
      <a href="#services">Ver Servicios</a>
    </button>
  </div>
</section>

<style>
  /* Entrada de texto */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
  .animation-delay-200 {
    animation-delay: 0.2s;
  }
  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  /* Fallback para cuando no haya JS */
  .parallax-bg img {
    object-position: center top;
  }

  /* Ajustes específicos para mobile */
  @media (max-width: 640px) {
    .parallax-bg img {
      transform: scale(1) !important;
    }
  }
</style>

<script>
  // Fallback JS para parallax cross-browser
  document.addEventListener('scroll', () => {
    const bg = document.querySelector('.parallax-bg img');
    if (!bg) return;
    const scrolled = window.scrollY;
    const isMobile = window.innerWidth < 640;
    const scale = isMobile ? 0.1 : 1.1;
    bg.style.transform = `translateY(${-scrolled * 0.3}px) scale(${scale})`;
  });

  document.addEventListener('scroll', () => {
    const text = document.querySelector('.parallax-text div');
    if (!text) return;
    const scrolled = window.scrollY;
    text.style.transform = `translateY(${scrolled * 0.05}px)`;
  });
</script>
