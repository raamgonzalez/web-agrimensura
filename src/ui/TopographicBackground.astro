<style>
  .background {
    animation: parallaxMove ease-in-out both;
    animation-timeline: view();
    animation-range: entry 10% cover 60%;
  }
  @keyframes parallaxMove {
    from {
      opacity: 0;
      scale: 0.5;
      filter: blur(10px);
    }
    to {
      opacity: 0.2;
      scale: 1;
      filter: blur(0px);
    }
  }
</style>
