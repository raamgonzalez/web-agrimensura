---
const { title, description } = Astro.props;
---

<section class="w-full max-w-2xl">
  <h2
    class="text-secondary font-bold text-title-mobile sm:text-title-tablet md:text-title-web mb-2"
  >
    {title}
  </h2>
  {
    description ? (
      <p class="font-inter text-desc-mobile sm:text-desc-tablet md:text-desc-web ml-8">
        {description}
      </p>
    ) : null
  }
</section>
