---
const { title, description, margin } = Astro.props;
---

<section class="w-full max-w-2xl flex flex-col gap-4 md:gap-8">
  <h2 class="text-heading font-bold text-title-mobile sm:text-title-tablet md:text-title-web mb-2">
    {title}
  </h2>
  {
    description ? (
      <p
        class={`text-primary font-inter text-desc-mobile sm:text-desc-tablet md:text-desc-web ${margin ?? null}`}
      >
        {description}
      </p>
    ) : null
  }
</section>
