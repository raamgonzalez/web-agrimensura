---
const {
  content,
  subcontent,
  contentColor = 'text-orange-500',
  hoverColor = 'hover:bg-backgrund',
} = Astro.props;
---

<div
  class={`
  group relative overflow-hidden
  bg-muted/30 rounded-xl p-8
  border border-background
  transition-all duration-300 ease-in-out
  shadow-primary
  hover:bg-muted/30
  hover:scale-105
  active:bg-muted/30
  active:scale-105
  hover:shadow-sm
  active:shadow-sm
  ${hoverColor}
  cursor-pointer
  flex flex-col items-center justify-center
`}
>
  <!-- Background hover effect -->
  <div
    class="absolute inset-0 bg-gradient-to-br to-muted/50 from-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <!-- Content container -->
  <div class="relative z-10 text-center lg:px-8">
    <!-- Main content -->
    <div
      class={`
      text-5xl lg:text-5xl xl:text-6xl font-bold mb-4
      ${contentColor}
      transition-all duration-300
      group-hover:scale-110
      group-hover:text-orange-600
      [text-shadow:0px_2px_1px_#d76c37bb]
      text-shadow-muted
    `}
    >
      {content}
    </div>

    <!-- Subcontent -->
    <div
      class="text-primary font-medium
      transition-all duration-300
      group-hover:text-primary
      group-hover:translate-y-1"
    >
      {subcontent}
    </div>
  </div>

  <!-- Decorative elements that appear on hover -->
  <div
    class="absolute top-4 right-4 w-2 h-2 bg-accent rounded-full opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-150 group-active:opacity-100 group-active:scale-150"
  >
  </div>
  <div
    class="absolute bottom-4 left-4 w-1 h-1 bg-accent rounded-full opacity-0 group-hover:opacity-100 transition-all duration-700 group-hover:scale-200 group-active:opacity-100 group-active:scale-150"
  >
  </div>
</div>
