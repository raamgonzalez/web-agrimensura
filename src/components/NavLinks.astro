---
const links = [
  { name: 'Nosotros', url: '#about', typeButton: false },
  { name: 'Servicios', url: '#services', typeButton: false },
  { name: 'Proyectos', url: '#projects', typeButton: false },
  { name: 'Contacto', url: '#contact', typeButton: true },
];
---

{
  links.map((link) => {
    return link.typeButton ? (
      <button
        type="button"
        class="px-6 py-2 rounded-lg bg-accent flex justify-center items-center gap-x-2 text-sm font-medium border border-transparent  text-white hover:bg-muted focus:outline-hidden focus:bg-gray-600 disabled:opacity-50 disabled:pointer-events-none cursor-pointer transition-colors duration-200 shadow-2xl shadow-accent text-center"
      >
        <a href={link.url}>{link.name}</a>
      </button>
    ) : (
      <a
        href={link.url}
        class="text-center text-secondary hover:text-accent transition-colors duration-200 font-medium"
      >
        {link.name}
      </a>
    );
  })
}
