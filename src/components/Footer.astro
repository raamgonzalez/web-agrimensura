---
import Logo from '../ui/Logo.astro';
import { data } from '../data/data';
import { icons } from '@/data/helper';

const { networks } = data;
---

<footer>
  <div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      <!-- Logo gris para footer -->
      <div class="flex justify-center md:justify-start">
        <Logo loading="lazy" />
      </div>

      <!-- Información de la empresa -->
      <div class="text-center">
        <h3 class="text-lg font-semibold mb-2">DGA Agrimensura</h3>
        <p class="text-sm">
          Servicios profesionales de agrimensura<br />
          Precisión y confianza en cada proyecto
        </p>
      </div>

      <!-- Redes sociales con iconos SVG -->
      <div class="flex justify-center md:justify-end gap-4">
        {
          networks.footer.map(({ name, url, icon }) => {
            const Icon = icons[icon];
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 border-b-1 text-primary rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110"
                aria-label={name}
              >
                <Icon color="#4c4d4c" />
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t mt-8 pt-8 text-center border-muted">
      <p class="text-sm font-inter">© 2024 DGA Agrimensura. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
