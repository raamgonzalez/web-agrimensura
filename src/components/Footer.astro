---
import Logo from '../ui/Logo.astro';
import { data } from '../data/data';
import { icons } from '@/data/helper';

const { networks } = data;
---

<footer class="">
  <div class="">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center border-muted border-t border-b">
      <div class="flex justify-center md:justify-start">
        <Logo loading="lazy" />
      </div>

      <div class="text-center">
        <h3 class="text-lg mb-2 text-primary font-bold">DGA Agrimensura</h3>
        <p class="text-sm">
          Servicios profesionales de agrimensura<br />
          Precisión y confianza en cada proyecto
        </p>
      </div>

      <div class="flex justify-center md:justify-end gap-4">
        {
          networks.footer.map(({ name, url, icon }) => {
            const Icon = icons[icon as keyof typeof icons];
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 border-b-1 text-primary rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110"
                aria-label={name}
              >
                <Icon color="#4c4d4c" />
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="text-sm font-inter">© 2024 Agrimensura DGA. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
