---
import Logo from '../ui/Logo.astro';
import NavLinks from './NavLinks.astro';

const links = [
  { name: 'Nosotros', url: '/nosotros', typeButton: false },
  { name: 'Proyectos', url: '/proyectos', typeButton: false },
  { name: 'Contacto', url: '/contacto', typeButton: true },
];
---

<header class="bg-background sticky top-0 z-50 transition-shadow duration-300 rounded-b-xl">
  <div>
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <Logo loading="eager" />
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <NavLinks />
      </nav>
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-foreground justify-center rounded-md transition-colors duration-200 items-center"
        aria-label="Abrir menú de navegación"
      >
        <svg
          class="h-14 w-auto text-primary items-center justify-center flex-col"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="md:hidden hidden">
      <div
        class="px-2 pt-2 pb-3 space-y-1 flex flex-col gap-4 bg-background rounded-b-xl shadow-lg"
      >
        <NavLinks />
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation(); // evita que el click cierre el menú enseguida
      menu.classList.toggle('hidden');
    });

    // Si hago click en cualquier lado fuera del menú y del botón → se cierra
    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('hidden')) {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
          menu.classList.add('hidden');
        }
      }
    });
  }
</script>
