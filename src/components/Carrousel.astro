---
import { Image } from 'astro:assets';
import { data } from '../data/data';
import ChipProyecto from '../ui/ChipProyecto.astro';
const { projects } = data;
---

<div
  data-hs-carousel='{
    "loadingClasses": "opacity-0",
    "dotsItemClasses": "hs-carousel-active:bg-accent hs-carousel-active:border-accent size-3 border border-primary rounded-full cursor-pointer dark:border-primary dark:hs-carousel-active:bg-secondary dark:hs-carousel-active:border-primary mb-2",
    "isAutoPlay": true
  }'
  class="relative"
>
  <div
    class="hs-carousel relative overflow-hidden w-full xl:h-[900px] md:h-[600px] sm:h-[400px] h-[300px] rounded-md"
  >
    <div
      class="hs-carousel-body absolute top-0 bottom-0 start-0 flex flex-nowrap transition-transform duration-700 opacity-0"
    >
      {
        projects.map((project) => {
          return (
            <div class="hs-carousel-slide relative">
              <ChipProyecto name={project.name} />
              <div class="flex justify-center h-full">
                <Image
                  src={project.src}
                  class="w-full rounded-4xl object-cover"
                  alt={project.alt}
                  inferSize={true}
                  loading="eager"
                />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <button
    type="button"
    class="hs-carousel-prev hs-carousel-disabled:opacity-50 hs-carousel-disabled:pointer-events-none absolute inset-y-0 start-0 inline-flex justify-center items-center w-11.5 h-full focus:outline-hidden rounded-s-lg pl-8"
  >
    <span
      class="text-2xl text-background bg-muted/30 p-2 sm:p-4 rounded-md cursor-pointer"
      aria-hidden="true"
    >
      <svg
        class="shrink-0 size-5"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </span>
  </button>
  <button
    type="button"
    class="hs-carousel-next hs-carousel-disabled:opacity-50 hs-carousel-disabled:pointer-events-none absolute inset-y-0 end-0 inline-flex justify-center items-center w-11.5 h-full focus:outline-hidden rounded-e-lg pr-8"
  >
    <span class="sr-only">Next</span>
    <span
      class="text-2xl text-background bg-muted/30 p-2 sm:p-4 rounded-md cursor-pointer"
      aria-hidden="true"
    >
      <svg
        class="shrink-0 size-5"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </span>
  </button>

  <div class="hs-carousel-pagination flex justify-center absolute bottom-3 start-0 end-0 gap-x-2">
  </div>
</div>
