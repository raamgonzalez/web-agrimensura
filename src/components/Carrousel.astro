---
import { Image } from 'astro:assets';
import { data } from '../data/data';
import ChipProyecto from '../ui/ChipProyecto.astro';

const { projects } = data;
---

<div class="carrousel w-full mx-auto">
  <div class="swiper astro-swiper group">
    <div class="swiper-wrapper">
      {
        projects.map((project) => (
          <div class="swiper-slide hs-carousel-slide relative" key={project.name}>
            <ChipProyecto name={project.name} />
            <div class="flex justify-center h-[300px] sm:h-[400px] md:h-[500px] lg:h-[500px] xl:h-[800px] w-full">
              <Image
                src={project.src}
                alt={project.alt}
                class="image__carrousel w-full h-full object-cover object-top object-center"
                inferSize={true}
                loading="eager"
              />
            </div>
          </div>
        ))
      }
    </div>

    <button
      class="swiper-button-prev flex flex-col custom-swiper-btn group-hover:flex items-center justify-center text-primary w-10 h-10 sm:w-12 sm:h-12 rounded-full shadow-md absolute left-2 top-1/2 -translate-y-1/2 z-30"
      aria-label="Anterior"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 sm:w-6 sm:h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="oklch(0.65 0.15 45)"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>

    <button
      class="swiper-button-next custom-swiper-btn hidden group-hover:flex items-center justify-center text-primary w-10 h-10 sm:w-12 sm:h-12 rounded-full shadow-md absolute right-2 top-1/2 -translate-y-1/2 z-30"
      aria-label="Siguiente"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 sm:w-6 sm:h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="oklch(0.65 0.15 45)"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"></path>
      </svg>
    </button>

    <div class="swiper-pagination mt-4"></div>
  </div>

  <!-- Script robusto (CDN fallback) - se ejecuta solo en cliente -->
  <script type="module" client:load>
    const SWIPER_UMD = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
    const SWIPER_CSS = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';

    // inyectar CSS CDN si no está
    if (!document.querySelector('link[data-swiper-cdn]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = SWIPER_CSS;
      link.setAttribute('data-swiper-cdn', '1');
      document.head.appendChild(link);
    }

    function initFromWindow() {
      if (!window.Swiper) return console.warn('Swiper no disponible en window');

      document.querySelectorAll('.astro-swiper').forEach((el) => {
        if (el.__swiper) return;

        const paginationEl = el.querySelector('.swiper-pagination');
        const nextEl = el.querySelector('.swiper-button-next');
        const prevEl = el.querySelector('.swiper-button-prev');

        const swiper = new window.Swiper(el, {
          init: false,
          loop: true,
          slidesPerView: 1,
          spaceBetween: 30,
          autoplay: { delay: 4000, disableOnInteraction: false },
          pagination: { el: paginationEl, clickable: true },
          navigation: { nextEl, prevEl },
          keyboard: { enabled: true },
          observer: true,
          observeParents: true,
          on: {
            init() {
              el.classList.add('swiper-initialized');
            },
          },
        });

        // esperar 2 frames para asegurar layout final de imágenes
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            try {
              swiper.init();
              el.__swiper = swiper;
            } catch (err) {
              console.error('Error inicializando Swiper:', err);
            }
          })
        );
      });
    }

    if (window.Swiper) {
      initFromWindow();
    } else {
      const s = document.createElement('script');
      s.src = SWIPER_UMD;
      s.async = true;
      s.onload = () => initFromWindow();
      s.onerror = (e) => console.error('No se pudo cargar Swiper CDN', e);
      document.head.appendChild(s);
    }
  </script>

  <style>
    .image__carrousel {
      border-radius: 2rem;
    }

    .astro-swiper .swiper-wrapper {
      display: flex !important;
      align-items: stretch;
    }
    .astro-swiper .swiper-slide {
      flex-shrink: 0 !important;
      width: 100% !important;
    }
    .astro-swiper {
      position: relative;
      width: 100%;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      display: none !important;
    }

    .astro-swiper .swiper-pagination-bullet-active {
      background: oklch(0.65 0.15 45);
      transform: scale(1.15);
    }

    .carrousel {
      animation: zoom ease-out both;
      animation-timeline: view();
      animation-range: entry 10% cover 30%;
    }
  </style>
</div>
